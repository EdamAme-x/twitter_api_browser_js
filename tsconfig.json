{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "lib": ["ES2024", "DOM"],
    "noEmit": false,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
     "moduleResolution": "Bundler"
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules", "dist", "testing", "example.ts"]
}

